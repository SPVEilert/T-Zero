{
  "name": "t-zero",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "backend": "npx ampx sandbox",
    "frontend": "npx expo start --tunnel",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "prepare": "husky",
    "format-and-stage": "prettier --write . && git add .",
    "type-check": "tsc --noEmit",
    "update": "npx npm-check-updates -u && npm install",
    "check-updates": "npx npm-check-updates",
    "check-updates:update": "npx npm-check-updates -u"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "aws-amplify": "^6.15.9",
    "expo": "^54.0.29",
    "expo-status-bar": "~3.0.9",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.19.0",
    "@aws-amplify/backend-cli": "^1.8.1",
    "@babel/core": "^7.28.5",
    "@types/react": "~19.1.10",
    "aws-cdk-lib": "^2.232.2",
    "constructs": "^10.4.4",
    "esbuild": "^0.27.1",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "private": true
}
